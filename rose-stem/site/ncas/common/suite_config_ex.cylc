{% do LOG.debug("Entered site/ncas/common/suite_config_ex.cylc") %}

{% set ex_base = 'umask 0022 ; '~
                   'source . ; ' %}

#{% set ex_compiler_gnu = 'module load spack_gnu' %}
{# see if we need this at some point #}

    [[EX_BASE]]
        platform = cirrus-bg
        [[[environment]]]
            BUILD_ROOT = ${CYLC_TASK_WORK_DIR}/${CYLC_WORKFLOW_NAME_BASE}_${USER}
            HYPERTHREADS    = 1
            CORES_PER_NODE  = 128
            NUMA_REGIONS_PER_NODE = 8
            LUSTRE_FILESYSTEM = false

    [[EX_SLURM]]
        inherit = EX_BASE
        platform = cirrus
        [[[environment]]]
            ROSE_LAUNCHER = srun
        [[[directives]]]
            --account={{ HPC_ACCOUNT }}
            --chdir=/epccfs/n02/n02/{{ HPC_USERNAME }}

    [[EX_GNU]]
        pre-script = """
                     umask 0022
                     module load spack
                     spack env activate /epccfs/n02/n02/dcase/HPC_envs_climate_science/central_cirrus_gnu/
                     source /epccfs/n02/n02/dcase/HPC_envs_climate_science/central_cirrus_gnu/.venv/bin/activate
                     module load PrgEnv-gnu
                     module load cray-hdf5-parallel/1.14.3.5
                     module load cray-netcdf-hdf5parallel/4.9.0.17
                     unset BASH_XTRACEFD
                     """
        [[[environment]]]
             COMPILER = 'gnu'
             FC='ftn'
             FPP='gfortran -E -x f95-cpp-input'
             CRAY_ENVIRONMENT='TRUE'
             PE_ENV='GNU'
             LDMPI='ftn'
             VERBOSE='3'
             USE_LEGACY_TIMER="false"
             USE_TIMING_WRAPPER="false"

    [[EX_CCE]]
        pre-script = """
                     umask 0022
                     """
        [[[environment]]]
             COMPILER = 'cce'

    [[EX_BUILD_GNU]]
        inherit = EX_SLURM, EX_GNU

    [[EX_BUILD_CCE]]
        inherit = EX_SLURM, EX_CCE

    [[EX_RUN]]
        [[[environment]]]
            BIG_DATA_DIR   = '/work/y07/shared/lfric/data/'
            SMALL_DATA_DIR = '/work/y07/shared/lfric/data/'
            TARGET_PLATFORM = 'ncas-ex'
            RUN_METHOD = srun

    [[EX_MESH]]
        inherit = EX_SLURM

    [[EX_MESH_GNU]]
        inherit = EX_MESH, EX_GNU
        [[[environment]]]
            ROSE_APP_COMMAND_KEY = srun

    [[EX_MESH_CCE]]
        inherit = EX_MESH, EX_CCE
        [[[environment]]]
            ROSE_APP_COMMAND_KEY = srun

    [[EX_EXPORT-SOURCE]]
        inherit = NCAS_ORIG
        [[[environment]]]
            hostname = 'login.cirrus.ac.uk'
            PLATFORM_SYNC = true

    [[EX_RUN_GNU]]
       inherit = EX_SLURM, EX_RUN, EX_GNU

    [[EX_RUN_CCE]]
       inherit = EX_SLURM, EX_RUN, EX_CCE

    [[EX_TECH_BASE]]
        inherit = EX_SLURM

    [[EX_PLOT]]
        inherit = EX_TECH_BASE

    [[EX_CHECK]]
        inherit = EX_BASE

    [[EX_HOUSEKEEPING]]

{% do LOG.debug("Finished in site/mcas/common/suite_config_ex.cylc") %}
